      "depends_on": ["xhs_search", "xhs_interact", "xhs_edit", "xhs_publish", "search_anywhere"]
    },
    "xhs_review": {
      "layer": "workflow",
      "path": "hard_skills/xhs_review/SKILL.md",
      "routable": false,
