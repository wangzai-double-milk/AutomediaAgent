# ==========================================
# 代理与反爬配置池 (防风控专用)
# ==========================================
# Agent 在一次探索中，最多允许向下滚动小红书页面的次数。
# 滚动太多次可能会触发验证码，太少则可能获取不到足够的信息。
MAX_SCROLL_TIMES=20

# 模拟真实人类操作的延迟时间（秒）。
# 每次点击、点赞、收藏等动作后，会在这两个值之间随机停顿，防止被识别为机器人。
ACTION_DELAY_MIN=2.0
ACTION_DELAY_MAX=6.0

# ==========================================
# 运行参数
# ==========================================
# Agent 后台自主学习的触发间隔时间（单位：秒）。
# 默认 1800 秒（30分钟）。如果想让它学得更快，可以改小（如 300）；如果怕封号，可以改大。
INTERVAL=1800

# Chrome 浏览器的 CDP (Chrome DevTools Protocol) 调试端口。
# 默认 9222。用于底层自动化脚本接管和穿透浏览器操作。
CDP_PORT=9222

# ==========================================
# 敏感信息
# ==========================================
# 大模型 API Key 等敏感信息 (请不要提交到 Git)
# OPENAI_API_KEY=your_api_key_here
