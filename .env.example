# 可选配置。首次复制为 .env，已有文件不要覆盖；不要提交真实密钥。
# 密钥与模型环境变量会覆盖 config.json 对应值。
# VOLC_API_KEY=your_key
# VOLC_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# VOLC_LLM_MODEL=your_text_model_id
# VOLC_VLM_MODEL=your_vision_model_id
# VOLC_GEN_MODEL=your_image_generation_model_id
# VOLC_EDIT_MODEL=your_image_editing_model_id
# AUTOMEDIA_CONFIG=/absolute/path/to/config.json

# Studio 仅本机可用。端口占用时更换端口，不自动清理已有进程。
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=14168
STUDIO_NO_BROWSER=0

# 仅 reflect/autonomous.py 使用；普通 Studio 对话不会自动开启后台运营。
INTERVAL=1800

# 浏览器连接依赖 assets/tmwd_cdp_bridge 扩展：
# WebSocket 18765，HTTP 兼容通道 18766。
# 当前实现不读取 CDP_PORT / ACTION_DELAY_MIN / ACTION_DELAY_MAX。
